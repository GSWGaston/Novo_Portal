# Auto-detect text files and normalise line endings to LF in the repo
* text=auto

# Shell scripts must always use LF, even on Windows
*.sh text eol=lf

# Batch files must always use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
# PDFs e imagens são binários: sem conversão de fim de linha (o Git corrompia os PDFs no Windows)
*.pdf binary
*.png binary
*.jpg binary
*.webp binary
